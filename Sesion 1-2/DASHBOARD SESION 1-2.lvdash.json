{
  "datasets": [
    {
      "name": "afaef849",
      "displayName": "Ventas por Producto y Categoría",
      "queryLines": [
        "SELECT\r\n",
        "  date_trunc('month', v.fecha) AS mes,\r\n",
        "  d.categoria,\r\n",
        "  v.producto,\r\n",
        "  SUM(v.cantidad) AS unidades_vendidas,\r\n",
        "  SUM(v.cantidad * v.precio) AS importe_total,\r\n",
        "  AVG(v.precio) AS precio_medio\r\n",
        "FROM\r\n",
        "  sesion1.data.productos v\r\n",
        "    JOIN sesion1.data.dim_producto d\r\n",
        "      ON v.producto = d.nombre_producto\r\n",
        "WHERE\r\n",
        "  v.fecha BETWEEN :fecha_desde AND :fecha_hasta\r\n",
        "  AND (\r\n",
        "    array_contains(:categoria, 'All')\r\n",
        "    OR array_contains(:categoria, d.categoria)\r\n",
        "  )\r\n",
        "GROUP BY\r\n",
        "  mes,\r\n",
        "  d.categoria,\r\n",
        "  v.producto\r\n",
        "ORDER BY\r\n",
        "  mes,\r\n",
        "  importe_total DESC"
      ],
      "parameters": [
        {
          "displayName": "Fecha Desde",
          "keyword": "fecha_desde",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now-1y/y"
                }
              ]
            }
          }
        },
        {
          "displayName": "Fecha Hasta",
          "keyword": "fecha_hasta",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        },
        {
          "displayName": "Categoría",
          "keyword": "categoria",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    }
  ],
