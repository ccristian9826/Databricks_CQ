{
  "datasets": [
    {
      "name": "d63570e3",
      "displayName": "Monthly Sales Summary by Category and Product",
      "queryLines": [
        "SELECT\r\n",
        "  date_trunc('month', v.fecha)              AS mes,\r\n",
        "  d.categoria,\r\n",
        "  v.producto,\r\n",
        "  SUM(v.cantidad)                           AS unidades_vendidas,\r\n",
        "  SUM(v.cantidad * v.precio)                AS importe_total,\r\n",
        "  AVG(v.precio)                             AS precio_medio\r\n",
        "FROM sesion1.data.productos v\r\n",
        "JOIN sesion1.data.dim_producto d\r\n",
        "  ON v.producto = d.nombre_producto\r\n",
        "WHERE\r\n",
        "  v.fecha BETWEEN :fecha_desde AND :fecha_hasta\r\n",
        "  AND (:categoria = 'All' OR d.categoria = :categoria)\r\n",
        "GROUP BY\r\n",
        "  mes, d.categoria, v.producto\r\n",
        "ORDER BY\r\n",
        "  mes, importe_total DESC;"
      ],
      "parameters": [
        {
          "displayName": "fecha_desde",
          "keyword": "fecha_desde",
          "dataType": "DATETIME",
          "defaultSelection": {
            "values": {
              "dataType": "DATETIME",
              "values": [
                {
                  "value": "now-1y/y"
                }
              ]
            }
          }
        },
        {
          "displayName": "fecha_hasta",
          "keyword": "fecha_hasta",
          "dataType": "DATETIME",
          "defaultSelection": {
            "values": {
              "dataType": "DATETIME",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        },
        {
          "displayName": "categoria",
          "keyword": "categoria",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    }
  ],
